{
  "manifest_version": 3,
  "name": "私信获客 Cookie 助手",
  "version": "1.0.0",
  "description": "一键复制抖音登录 Cookie，用于 CRM「私信获客画像」绑定账号，免去打开开发者工具的麻烦",
  "permissions": ["cookies", "activeTab"],
  "host_permissions": ["https://*.douyin.com/*"],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "私信获客 Cookie 助手"
  }
}
