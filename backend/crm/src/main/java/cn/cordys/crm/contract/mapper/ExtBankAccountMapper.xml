<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="cn.cordys.crm.contract.mapper.ExtBankAccountMapper">

    <select id="list" resultType="cn.cordys.crm.contract.dto.response.BankAccountListResponse">
        SELECT
        ba.id,
        ba.name,
        ba.type,
        ba.opening_bank,
        ba.bank_account,
        ba.account_holder,
        ba.qrcode,
        ba.remark,
        ba.organization_id,
        ba.create_time,
        ba.update_time,
        ba.create_user,
        ba.update_user
        FROM
        bank_account ba
        WHERE
        ba.organization_id = #{orgId}
        <if test="request.keyword != null and request.keyword != ''">
            and ba.name like concat('%', #{request.keyword},'%')
        </if>

        <include refid="filters">
            <property name="filters" value="request.filters"/>
        </include>

        <include refid="combine">
            <property name="combineSearch" value="request.combineSearch"/>
        </include>
        <include refid="sort">
            <property name="sort" value="request.sort"/>
        </include>

    </select>

    <sql id="filters">
        <if test="${filters} != null and ${filters}.size() > 0">
            <trim prefix="and">
                <foreach collection="${filters}" item="condition" open="(" close=")" index="i" separator="and">
                    <include refid="condition">
                        <property name="condition" value="condition"/>
                    </include>
                </foreach>
            </trim>
        </if>
    </sql>

    <sql id="condition">
        <choose>
            <when test="condition.name == 'id'">
                <include refid="cn.cordys.common.mapper.CommonMapper.condition">
                    <property name="condition" value="condition"/>
                    <property name="column" value="ba.id"/>
                </include>
            </when>
            <when test="condition.name == 'name'">
                <include refid="cn.cordys.common.mapper.CommonMapper.condition">
                    <property name="condition" value="condition"/>
                    <property name="column" value="ba.name"/>
                </include>
            </when>
            <when test="condition.name == 'type'">
                <include refid="cn.cordys.common.mapper.CommonMapper.condition">
                    <property name="condition" value="condition"/>
                    <property name="column" value="ba.type"/>
                </include>
            </when>
            <when test="condition.name == 'openingBank'">
                <include refid="cn.cordys.common.mapper.CommonMapper.condition">
                    <property name="condition" value="condition"/>
                    <property name="column" value="ba.opening_bank"/>
                </include>
            </when>
            <when test="condition.name == 'bankAccount'">
                <include refid="cn.cordys.common.mapper.CommonMapper.condition">
                    <property name="condition" value="condition"/>
                    <property name="column" value="ba.bank_account"/>
                </include>
            </when>
            <when test="condition.name == 'accountHolder'">
                <include refid="cn.cordys.common.mapper.CommonMapper.condition">
                    <property name="condition" value="condition"/>
                    <property name="column" value="ba.account_holder"/>
                </include>
            </when>
            <when test="condition.name == 'remark'">
                <include refid="cn.cordys.common.mapper.CommonMapper.condition">
                    <property name="condition" value="condition"/>
                    <property name="column" value="ba.remark"/>
                </include>
            </when>
            <when test="condition.name == 'createTime'">
                <include refid="cn.cordys.common.mapper.CommonMapper.condition">
                    <property name="condition" value="condition"/>
                    <property name="column" value="ba.create_time"/>
                </include>
            </when>
            <when test="condition.name == 'updateTime'">
                <include refid="cn.cordys.common.mapper.CommonMapper.condition">
                    <property name="condition" value="condition"/>
                    <property name="column" value="ba.update_time"/>
                </include>
            </when>
            <when test="condition.name == 'updateUser'">
                <include refid="cn.cordys.common.mapper.CommonMapper.condition">
                    <property name="condition" value="condition"/>
                    <property name="column" value="ba.update_user"/>
                </include>
            </when>
            <when test="condition.name == 'createUser'">
                <include refid="cn.cordys.common.mapper.CommonMapper.condition">
                    <property name="condition" value="condition"/>
                    <property name="column" value="ba.create_user"/>
                </include>
            </when>
        </choose>
    </sql>

    <sql id="combine">
        <if test="${combineSearch} != null and ${combineSearch}.conditions != null and ${combineSearch}.conditions.size() > 0">
            <trim prefix="and">
                <trim prefix="(" suffix=")" suffixOverrides="and|or">
                    <foreach collection="${combineSearch}.conditions" index="i" item="condition">
                        <include refid="condition">
                            <property name="condition" value="condition"/>
                        </include>
                        <include refid="cn.cordys.common.mapper.CommonMapper.searchMode">
                            <property name="searchMode" value="${combineSearch}.searchMode"/>
                        </include>
                    </foreach>
                </trim>
            </trim>
        </if>
    </sql>

    <sql id="sort">
        <choose>
            <when test="${sort} != null and ${sort}.valid()">
                <bind name="sortType" value="${sort}.type"/>
                <bind name="sortName" value="${sort}.name"/>
                order by
                <choose>
                    <when test="${sort}.name in
                        {'name', 'create_time', 'update_time', 'opening_bank', 'bank_account', 'account_holder', 'create_user', 'update_user', 'remark'
                        }">
                        ba.${sortName} ${sortType}, ba.id ASC
                    </when>
                    <otherwise>
                        order by ba.create_time desc, ba.id asc
                    </otherwise>
                </choose>
            </when>
            <otherwise>
                order by ba.create_time desc, ba.id asc
            </otherwise>
        </choose>
    </sql>

    <select id="countByName" resultType="java.lang.Integer">
        select count(id) from bank_account ba
        where ba.organization_id = #{orgId}
        and ba.name = #{name}
        <if test="id != null and id != ''">
            AND ba.id != #{id}
        </if>
    </select>

</mapper>
